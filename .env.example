# Copy to .env next to anker_ups.py / anker_ups.exe and fill in.

# Anker account that owns the power station (shared accounts get limited data).
# Accounts created via Apple/Google sign-in need a password set in the Anker app first.
ANKERUSER=you@example.com
ANKERPASSWORD=
# Two-letter country code of the account, e.g. DE, UA, PL, US
ANKERCOUNTRY=DE
# Optional: device serial if the account has more than one power station
ANKER_DEVICE_SN=

# Telegram bot from @BotFather and your chat id (e.g. from @userinfobot).
# Leave TG_BOT_TOKEN empty to disable Telegram (e.g. on a PC that only switches power plans).
TG_BOT_TOKEN=
# People and / or groups that get alerts, comma separated (group ids start with -100).
TG_CHAT_ID=
# Admins: user ids that can change settings and control the station (outputs, light) and manage
# users in the bot. Empty = the people in TG_CHAT_ID. More users can be added from the bot.
TG_ADMIN_IDS=

# Language for chats that have not chosen one: en, uk, ru, pl, de, es. Each chat can change it
# in ⚙️ Settings → 🌐 Language; private chats follow the Telegram app language by default.
BOT_LANGUAGE=en

# Optional dead man's switch, e.g. https://hc-ping.com/<uuid> from healthchecks.io: pinged every
# 5 minutes, the service alerts you when the pings stop (server or bot down).
HEALTHCHECK_URL=

# Defaults below can be changed later from the bot (⚙️ Settings → Notifications).
# Total charge (%) for the CRITICAL Telegram alert and Windows popup; 0 disables it
CRITICAL_LEVEL=10

# Time zone for message and log timestamps on Linux, e.g. Europe/Kyiv (empty = system time zone)
TIMEZONE=

# Daily summary (last 24 h + chart) at this local time, HH:MM; empty disables it
SUMMARY_TIME=09:00

# Windows only: power plan GUIDs (see `powercfg /list`).
# Battery: plan for an outage, default Power saver a1841308-3541-4fab-bc81-f71556f20b4a
POWER_PLAN_BATTERY=
# Grid: plan when power is back; empty = restore the plan active before the outage
POWER_PLAN_GRID=

# Weather and air quality (Open-Meteo) and air-raid alerts (NEPTUN, ubilling.net.ua as a fallback)
# for the status widget and the stats, all without keys. Coordinates for the weather (default Kyiv); WEATHER=0 turns it off.
LATITUDE=
LONGITUDE=
WEATHER=1
# Alert region as the feed names it ("м. Київ", "Київська область", "Львівська область"...) and the
# nearby one shown in yellow; ALERT_REGION=- turns alerts off.
ALERT_REGION=м. Київ
ALERT_NEAR=Київська область

# Optional Tuya / Smart Life smart plug: a free cloud project at iot.tuya.com (Cloud -> Development, IoT Core subscribed),
# your Smart Life account linked to it (Devices -> Link App Account), the project's Access ID / Secret
# and the plug's device id (Smart Life -> the plug -> Device Information -> Virtual ID).
# Region of the project's data center: eu (Central Europe), us, in, cn. Leave empty to not use a plug.
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=
TUYA_DEVICE_ID=
TUYA_REGION=eu
